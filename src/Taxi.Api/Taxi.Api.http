###############################################################################
# AUTH — OTP Flow  (POST /api/v1/auth/...)
###############################################################################

### Step 1 — Send OTP to phone
# @name sendOtp
POST {{baseUrl}}/v1/auth/send-otp
Content-Type: application/json

{
    "phone": "+31612345678"
}

###

### Step 2 — Verify OTP & receive tokens (registers user automatically if new)
POST {{baseUrl}}/v1/auth/verify-otp
Content-Type: application/json

{
    "phone": "+31612345678",
    "sessionToken": "{{sessionToken}}",
    "code": "1234"
}


###############################################################################
# DRIVERS  (GET|POST|PUT|DELETE /api/v1/drivers/...)
###############################################################################

### Get all drivers
GET {{baseUrl}}/v1/drivers
Authorization: Bearer {{token}}

###

### Get driver by ID
GET {{baseUrl}}/v1/drivers/{{driverId}}
Authorization: Bearer {{token}}

###

### Create a driver
POST {{baseUrl}}/v1/drivers
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "phone": "+31698765432",
    "nameEn": "Ahmed Al-Rashid",
    "nameAr": "أحمد الراشد",
    "licenseNumber": "DL-2024-00123"
}

###

### Update a driver's license number
PUT {{baseUrl}}/v1/drivers/{{driverId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "licenseNumber": "DL-2025-99999"
}

###

### Delete a driver
DELETE {{baseUrl}}/v1/drivers/{{driverId}}
Authorization: Bearer {{token}}

###

### Assign a vehicle to a driver
POST {{baseUrl}}/v1/drivers/{{driverId}}/vehicle
Authorization: Bearer {{token}}
Content-Type: application/json

"{{vehicleId}}"


###############################################################################
# VEHICLE TYPES  (GET|POST|PUT|DELETE /api/v1/vehicle-types/...)
###############################################################################

### Get vehicle type catalog (cached 60s)
GET {{baseUrl}}/v1/vehicle-types
Authorization: Bearer {{token}}
Accept-Language: en

###

### Get vehicle type catalog — Arabic
GET {{baseUrl}}/v1/vehicle-types
Authorization: Bearer {{token}}
Accept-Language: ar

###

### Get vehicle type catalog — Dutch
GET {{baseUrl}}/v1/vehicle-types
Authorization: Bearer {{token}}
Accept-Language: nl

###

### Get vehicle type by ID
GET {{baseUrl}}/v1/vehicle-types/{{vehicleTypeId}}
Authorization: Bearer {{token}}

###

### Get vehicle type by code
GET {{baseUrl}}/v1/vehicle-types/code/ECONOMY
Authorization: Bearer {{token}}

###

### Create a vehicle type
POST {{baseUrl}}/v1/vehicle-types
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "code": "ECONOMY",
    "nameEn": "Economy",
    "nameAr": "اقتصادي",
    "nameNl": "Economie",
    "capacity": 4,
    "ratePerKm": 1.20,
    "ratePerMin": 0.25,
    "minFare": 5.00,
    "currency": "USD",
    "sortOrder": 1
}

###

### Update a vehicle type (pricing + active flag)
PUT {{baseUrl}}/v1/vehicle-types/{{vehicleTypeId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "ratePerKm": 1.50,
    "ratePerMin": 0.30,
    "minFare": 6.00,
    "isActive": true
}

###

### Delete a vehicle type
DELETE {{baseUrl}}/v1/vehicle-types/{{vehicleTypeId}}
Authorization: Bearer {{token}}


###############################################################################
# VEHICLES  (GET|POST|PUT|DELETE /api/v1/vehicles/...)
###############################################################################

### Get all vehicles
GET {{baseUrl}}/v1/vehicles
Authorization: Bearer {{token}}

###

### Get vehicle by ID
GET {{baseUrl}}/v1/vehicles/{{vehicleId}}
Authorization: Bearer {{token}}

###

### Create a vehicle
POST {{baseUrl}}/v1/vehicles
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "vehicleTypeId": "{{vehicleTypeId}}",
    "driverId": "{{driverId}}",
    "make": "Toyota",
    "model": "Camry",
    "year": "2024",
    "color": "White",
    "licensePlate": "NL-123-AB"
}

###

### Update a vehicle (color, plate, active flag)
PUT {{baseUrl}}/v1/vehicles/{{vehicleId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "color": "Silver",
    "licensePlate": "NL-456-CD",
    "isActive": true
}

###

### Delete a vehicle
DELETE {{baseUrl}}/v1/vehicles/{{vehicleId}}
Authorization: Bearer {{token}}


###############################################################################
# TRIPS  (GET|POST /api/v1/trips/...)
###############################################################################

### Get trip by ID
GET {{baseUrl}}/v1/trips/{{tripId}}
Authorization: Bearer {{token}}

###

### Get pricing quotes for a route
# @name getQuotes
POST {{baseUrl}}/v1/trips/quotes
Authorization: Bearer {{token}}
Content-Type: application/json
    
{
    "stops": [
        {
            "latitude": 52.3676,
            "longitude": 4.9041
        },
        {
            "latitude": 52.3702,
            "longitude": 4.8952
        }
    ]
}

###

### Request a new trip (minimum 2 stops)
POST {{baseUrl}}/v1/trips/request
Accept-Language: ar
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "quoteId": "{{quoteId}}",
    "stops": [
        {
            "latitude": 52.3676,
            "longitude": 4.9041
        },
        {
            "latitude": 52.3702,
            "longitude": 4.8952
        }
    ]
}

###

### Request a multi-stop trip (3 stops)
POST {{baseUrl}}/v1/trips/request
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "quoteId": "{{quoteId}}",
    "stops": [
        {
            "latitude": 52.3676,
            "longitude": 4.9041
        },
        {
            "latitude": 52.3588,
            "longitude": 4.9080
        },
        {
            "latitude": 52.3702,
            "longitude": 4.8952
        }
    ]
}


###############################################################################
# OPENAPI
###############################################################################

### OpenAPI document
GET https://localhost:7007/openapi/v1.json


###############################################################################
# ERROR / EDGE CASES
###############################################################################

### 404 — Driver not found
GET {{baseUrl}}/v1/drivers/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept-Language: ar

###

### 404 — Vehicle not found
GET {{baseUrl}}/v1/vehicles/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept-Language: ar

###

### 404 — Vehicle type not found
GET {{baseUrl}}/v1/vehicle-types/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

### 404 — Trip not found
GET {{baseUrl}}/v1/trips/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

### 400 — Create driver with missing fields
POST {{baseUrl}}/v1/drivers
Authorization: Bearer {{token}}
Content-Type: application/json
Accept-Language: ar


{
    "phone": "",
    "nameEn": "",
    "nameAr": "",
    "licenseNumber": ""
}

###

### 400 — Request trip with only 1 stop (invalid — min 2 required)
POST {{baseUrl}}/v1/trips/request
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "quoteId": "{{quoteId}}",
    "stops": [
        {
            "latitude": 52.3676,
            "longitude": 4.9041
        }
    ]
}

###

### 400 — Create vehicle type with invalid capacity (0)
POST {{baseUrl}}/v1/vehicle-types
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "code": "BAD",
    "nameEn": "Bad Type",
    "nameAr": "نوع سيء",
    "nameNl": "Slecht type",
    "capacity": 0,
    "ratePerKm": 1.00,
    "ratePerMin": 0.10,
    "minFare": 3.00,
    "currency": "USD",
    "sortOrder": 99
}
