###############################################################################
# IDENTITY API
###############################################################################

### Login As Admin
# @name login
POST {{baseUrl}}/token/generate
Content-Type: application/json

{
    "email": "admin@taxi.com",
    "password": "Admin123!"
}

### Refresh Token
POST {{baseUrl}}/token/refresh-token
Content-Type: application/json

{
    "ExpiredAccessToken": "{{token}}",
    "refreshToken": "..."
}

### Get User Info
GET {{baseUrl}}/token/user-info
Authorization: Bearer {{token}}


###############################################################################
# CARS API
###############################################################################

### Get OpenAPI document
GET https://localhost:7007/openapi/v1.json

### Get all cars (English)
GET {{baseUrl}}/v1/cars
Authorization: Bearer {{token}}
Accept-Language: en

### Get all cars (Arabic)
GET {{baseUrl}}/v1/cars
Authorization: Bearer {{token}}
Accept-Language: ar

### Get all cars (Dutch)
GET {{baseUrl}}/v1/cars
Authorization: Bearer {{token}}
Accept-Language: nl

### Get car by Id
GET {{baseUrl}}/v1/cars/{{carId}}
Authorization: Bearer {{token}}
Accept-Language: en

### Create a new car
POST {{baseUrl}}/v1/cars
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "make": "Toyota",
    "model": "Camry",
    "year": 2024,
    "descriptionEn": "Reliable and fuel-efficient sedan.",
    "descriptionAr": "سيارة سيدان موثوقة وموفرة للوقود.",
    "descriptionNl": "Betrouwbare en zuinige sedan."
}

### Update an existing car
PUT {{baseUrl}}/v1/cars/{{carId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{carId}}",
    "make": "Toyota",
    "model": "Camry SE",
    "year": 2025,
    "descriptionEn": "Enhanced sport edition with premium features.",
    "descriptionAr": "نسخة رياضية مطورة بميزات فاخرة.",
    "descriptionNl": "Verbeterde sporteditie met premium functies."
}

### Remove a car
DELETE {{baseUrl}}/v1/cars/{{carId}}
Authorization: Bearer {{token}}


###############################################################################
# LOCALIZATION TEST PLAN — verify en/ar translation pipeline end to end
###############################################################################

### [LOC 1] Car NotFound, English
# Expect: 404, body.title = "Car not found."
GET {{baseUrl}}/v1/cars/00000000-0000-0000-0000-000000000000
Accept-Language: en
Authorization: Bearer {{token}}

### [LOC 2] Car NotFound, Arabic
# Expect: 404, body.title = "السيارة غير موجودة."
GET {{baseUrl}}/v1/cars/00000000-0000-0000-0000-000000000000
Accept-Language: ar
Authorization: Bearer {{token}}

### [LOC 5] Car NotFound, Dutch
# Expect: 404, body.title = "Auto niet gevonden."
GET {{baseUrl}}/v1/cars/00000000-0000-0000-0000-000000000000
Accept-Language: nl
Authorization: Bearer {{token}}

### [LOC 6] Domain Validation failure (Missing Description), Dutch
# Expect: 400, description required message in Dutch
POST {{baseUrl}}/v1/cars
Accept-Language: nl
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "make": "Tesla",
    "model": "Model 3",
    "year": 2024,
    "descriptionEn": "",
    "descriptionAr": "",
    "descriptionNl": ""
}
