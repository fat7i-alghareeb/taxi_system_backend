{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "TaxiServer",
    "Audience": "TaxiClient",
    "TokenExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 30
  },
  "AppSettings": {
    "CorsPolicyName": "TaxiCorsPolicy",
    "AllowedOrigins": [
      "http://localhost:5002",
      "https://localhost:7008",
      "https://api.fat7i.dev"
    ],
    "DefaultLanguage": "en",
    "ApiBaseUrl": "",
    "GoogleMapsApiKey": "",
    "Stripe": {
      "SecretKey": "",
      "PublishableKey": "",
      "WebhookSecret": "",
      "TestMode": true
    },
    "Features": {
      "StripeEnabled": false,
      "SignalREnabled": true
    }
  },
  "Invoice": {
    "Issuer": {
      "Name": "Fat7i",
      "Address": "",
      "VatNumber": null
    }
  },
  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "OtpRetentionDays": 30,
    "HashSecret": ""
  },
  "RefundReconciliation": {
    "PollIntervalMinutes": 5,
    "StuckPendingThresholdMinutes": 15
  },
  "Wallet": {
    "Currency": "EUR",
    "MinTopUpAmount": 5,
    "MaxTopUpAmount": 500
  },
  "Payments": {
    "EnabledMethodTypes": [ "card", "apple_pay", "google_pay", "ideal", "klarna", "paypal" ]
  },
  "Sms": {
    "CmCom": {
      "BaseUrl": "https://gw.messaging.cm.com/",
      "ProductToken": "",
      "Sender": "Fat7i"
    }
  },
  "Email": {
    "Titan": {
      "Host": "smtp.titan.email",
      "Port": 465,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "FromEmail": "",
      "FromName": "Fat7i",
      "ReplyToEmail": null
    }
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "XForwardedFor, XForwardedProto, XForwardedHost",
    "ForwardLimit": 1,
    "AllowAllInDevelopment": false,
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "AllowedHosts": "*"
}