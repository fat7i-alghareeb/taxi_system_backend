# Public domain
DOMAIN=api.fat7i.dev
CADDY_EMAIL=fat7ighareeb@gmail.com
API_BASE_URL=https://api.fat7i.dev
APP_ALLOWED_ORIGIN_0=https://api.fat7i.dev

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_strong_password_here

# API secrets
JWT_SECRET=generate_a_very_long_random_secret_at_least_32_characters
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here
FIREBASE_CREDENTIALS='{"type":"service_account","project_id":"your-firebase-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_MODE=false
STRIPE_ENABLED=true

# Invoices
INVOICE_ISSUER_NAME=Fat7i
INVOICE_ISSUER_ADDRESS=Your company address
INVOICE_ISSUER_VAT_NUMBER=

# Auth — OTP (backend-owned). Required: OTP_HASH_SECRET.
OTP_HASH_SECRET=generate_a_long_random_secret_at_least_32_characters
# Optional overrides (defaults shown):
# OTP_CODE_LENGTH=6
# OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_RETENTION_DAYS=30

# Auth — CM.com SMS (phone OTP). Required: CM_PRODUCT_TOKEN.
CM_PRODUCT_TOKEN=your_cmcom_gateway_product_token
CM_SENDER=Fat7i
# CM_BASE_URL=https://gw.messaging.cm.com/

# Auth — Titan.email SMTP (email OTP). Required: TITAN_USERNAME, TITAN_PASSWORD, TITAN_FROM_EMAIL.
TITAN_USERNAME=no-reply@yourdomain.com
TITAN_PASSWORD=your_titan_mailbox_or_app_password
TITAN_FROM_EMAIL=no-reply@yourdomain.com
# TITAN_FROM_NAME=Fat7i
# TITAN_HOST=smtp.titan.email
# TITAN_PORT=465        # 465 = SSL, 587 = STARTTLS
# TITAN_USE_SSL=true    # true for 465, false for 587
# TITAN_REPLY_TO_EMAIL=support@yourdomain.com

# Grafana
GRAFANA_ADMIN_PASSWORD=generate_grafana_admin_password

# Reverse proxy trust for Docker bridge networks
FORWARDED_HEADERS_KNOWN_NETWORK_0=172.16.0.0/12
