# Public domain
DOMAIN=api.fat7i.dev
CADDY_EMAIL=fat7ighareeb@gmail.com
API_BASE_URL=https://api.fat7i.dev
APP_ALLOWED_ORIGIN_0=https://api.fat7i.dev

# Database credentials
#
# Do NOT use the `postgres` superuser here. The API only needs DML on its own schema;
# running it as superuser turns any SQL flaw or container compromise into full cluster
# control (COPY ... FROM PROGRAM, extension loading, DROP DATABASE).
#
# Create a least-privilege role once, as superuser:
#   CREATE ROLE taxi_app LOGIN PASSWORD '<strong-password>';
#   GRANT CONNECT ON DATABASE "TaxiDb_Prod" TO taxi_app;
#   GRANT USAGE ON SCHEMA public TO taxi_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO taxi_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO taxi_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO taxi_app;
#
# Migrations run as a separate, higher-privilege role in the deploy step — never by the
# running API (Database:ApplyMigrationsOnStartup is false in production).
POSTGRES_USER=taxi_app
POSTGRES_PASSWORD=generate_a_very_strong_password_here

# Initial admin seed passwords. REQUIRED outside Development — seeding aborts rather than
# creating an admin with a built-in password. Both accounts are flagged RequiresPasswordReset.
# No complexity rules are enforced (any password is accepted), so the strength of these
# values is the only thing protecting the admin role.
SEED_ADMIN_PASSWORD=choose_an_admin_password
SEED_SECOND_ADMIN_PASSWORD=choose_a_different_admin_password

# API secrets
JWT_SECRET=generate_a_very_long_random_secret_at_least_32_characters
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here
FIREBASE_CREDENTIALS='{"type":"service_account","project_id":"your-firebase-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_MODE=false
STRIPE_ENABLED=true

# Invoices
INVOICE_ISSUER_NAME=Fat7i
INVOICE_ISSUER_ADDRESS=Your company address
INVOICE_ISSUER_VAT_NUMBER=

# Auth — OTP (backend-owned). Required: OTP_HASH_SECRET.
OTP_HASH_SECRET=generate_a_long_random_secret_at_least_32_characters
# Optional overrides (defaults shown):
# OTP_CODE_LENGTH=6
# OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_RETENTION_DAYS=30
# App store / Play Store reviewer bypass: this exact recipient (E.164 phone or
# lower-cased email — must NOT be a real customer's) always gets this fixed,
# non-expiring code instead of a real SMS/email. Leave both unset to disable.
# OTP_REVIEW_BYPASS_RECIPIENT=+10000000000
# OTP_REVIEW_BYPASS_CODE=123456

# Auth — CM.com SMS (phone OTP). Required: CM_PRODUCT_TOKEN.
CM_PRODUCT_TOKEN=your_cmcom_gateway_product_token
CM_SENDER=Fat7i
# CM_BASE_URL=https://gw.messaging.cm.com/

# Auth — Titan.email SMTP (email OTP). Required: TITAN_USERNAME, TITAN_PASSWORD, TITAN_FROM_EMAIL.
TITAN_USERNAME=no-reply@yourdomain.com
TITAN_PASSWORD=your_titan_mailbox_or_app_password
TITAN_FROM_EMAIL=no-reply@yourdomain.com
# TITAN_FROM_NAME=Fat7i
# TITAN_HOST=smtp.titan.email
# TITAN_PORT=465        # 465 = SSL, 587 = STARTTLS
# TITAN_USE_SSL=true    # true for 465, false for 587
# TITAN_REPLY_TO_EMAIL=support@yourdomain.com

# Grafana
GRAFANA_ADMIN_PASSWORD=generate_grafana_admin_password

# Reverse proxy trust for Docker bridge networks
FORWARDED_HEADERS_KNOWN_NETWORK_0=172.16.0.0/12
